{
  "name": "monk",
  "description": "The wise MongoDB API",
  "version": "8.0.0",
  "main": "dist/monk.cjs",
  "module": "dist/monk.mjs",
  "types": "./index.d.ts",
  "keywords": [
    "monk",
    "mongodb",
    "mongo",
    "driver"
  ],
  "files": [
    "dist",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/monk.mjs",
      "require": "./dist/monk.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Automattic/monk.git"
  },
  "type": "module",
  "dependencies": {
    "debug": "*",
  "mongodb": "^6.18.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.1",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@stylistic/eslint-plugin-js": "^2.7.2",
    "ava": "^6.1.3",
    "codecov": "^2.2.0",
    "eslint": "^9.9.1",
    "eslint-config-standard": "^10.2.1",
    "eslint-plugin-ava": "^4.2.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "gitbook-cli": "^2.3.0",
    "gitbook-plugin-anker-enable": "^0.0.4",
    "gitbook-plugin-custom-favicon": "0.0.4",
    "gitbook-plugin-edit-link": "2.0.2",
    "gitbook-plugin-github": "^2.0.0",
    "gitbook-plugin-prism": "^2.2.0",
    "mongodb-memory-server": "^10.2.0",
    "nyc": "^15.0.0",
    "rollup": "^4.16.4"
  },
  "license": "MIT",
  "scripts": {
    "test": "make test",
    "coverage": "nyc report --reporter=text-lcov > coverage.lcov && codecov",
    "docker": "docker run --name mongodb -p 27017:27017 -d mongo:4.4.29",
    "build": "make build"
  },
  "nyc": {
    "include": [
      "lib/**"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.mjs",
      "!test/entrypoints/*.mjs"
    ],
    "timeout": "10s"
  }
}
